{
  "name": "service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:ws --external:zod --external:pino --external:prom-client --outfile=dist/index.mjs",
    "start": "node --env-file-if-exists=../.env dist/index.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "6.0.3"
  },
  "type": "module",
  "dependencies": {
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "protocol": "workspace:*",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  }
}
