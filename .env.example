# Signaling server; copy to .env in the repository root.
HOST=0.0.0.0
PORT=3001
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MAX_FILE_BYTES=100000000
RECONNECT_MS=120000
OFFER_TIMEOUT_MS=60000
TRANSFER_TIMEOUT_MS=1800000
HEARTBEAT_MS=15000
MAX_CONNECTIONS=2000
MAX_CONNECTIONS_PER_IP=20
MAX_SESSIONS=4000
# Empty for local-only testing. Configure your own STUN and TURN for public use.
ICE_SERVERS_JSON=[]
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600
