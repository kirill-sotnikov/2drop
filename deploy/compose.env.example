# Copy to .env.production in the repository root.
# Also update the literal domains in deploy/traefik.yml when changing these.
APP_DOMAIN=2drop.app
TURN_DOMAIN=
# Required: actual public IPv4 of the Docker host, not its Docker/LAN address.
TURN_PUBLIC_IP=
# Generate each secret separately: openssl rand -hex 32
TURN_SECRET=
METRICS_TOKEN=
APP_VERSION=local
LOG_LEVEL=info
# Signalling sees Traefik's IP; this connection limit is shared by proxied users.
MAX_CONNECTIONS=2000
MAX_CONNECTIONS_PER_IP=2000
# Set relay temporarily to verify TURN, then rebuild web with all.
NEXT_PUBLIC_ICE_TRANSPORT_POLICY=all
